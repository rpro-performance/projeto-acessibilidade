    "coletar:rapido": "node coletor/index.js --sem-navegador",
    "agendar:mac": "bash coletor/instalar-mac.sh",
    "desagendar:mac": "bash coletor/desinstalar-mac.sh",
    "diagnostico": "node coletor/diagnostico.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "playwright": "^1.64.1"
  }
