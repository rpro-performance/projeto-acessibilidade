{
  "name": "veiculo-mais",
  "version": "0.1.0",
  "description": "Buscador unificado de veículos: uma busca, todos os sites.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "coletar": "node coletor/index.js",
